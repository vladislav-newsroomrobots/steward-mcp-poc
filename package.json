{
  "name": "steward-mcp-poc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Steward MCP server — ChatGPT-hosted replacement for the Steward Chrome extension (PoC)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run build:ui && tsx watch src/index.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "build": "npm run build:ui && tsc -p tsconfig.json",
    "build:ui": "node scripts/build-ui.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json",
    "smoke": "node scripts/smoke.mjs",
    "tunnel": "cloudflared tunnel --protocol http2 --url http://localhost:3000"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.1",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
