# Port the Streamable HTTP MCP endpoint listens on (http://localhost:$PORT/mcp)
PORT=3003

# Bind address. Keep it on loopback; tunnels reach the server outbound.
HOST=127.0.0.1

# Extra Host header values accepted by the DNS-rebinding guard, comma separated.
# localhost is always allowed. Set to * to disable the check entirely — useful
# with ephemeral tunnels that hand out a new hostname on every restart, but it
# also lets any site open in your browser reach this server. Local dev only.
ALLOWED_HOSTS=

# debug | info | warn | error
LOG_LEVEL=info

# When true, generation always uses pre-baked fallback drafts instead of the
# host model. Used as the demo safety net (see docs stage 6/7).
DEMO_MODE=false
